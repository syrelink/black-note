# black-note-app/src/api/generated/

# ==========================================
# 后端项目 (black-note-server) — 已从 git 移除，整体忽略
# ==========================================
black-note-server/
*.class
*.log

# ==========================================
# LangGraph / LangChain 相关
# ==========================================
# SQLite Checkpointer 数据库（已迁移到 MongoDB，仍忽略遗留文件）
*.db
*.sqlite
*.sqlite3

# LangGraph 持久化目录
checkpoints/
langgraph_checkpoints/

# LangChain / LangGraph 缓存
.langchain/
.langgraph/
*.pickle
*.pkl

# ==========================================
# 向量库本地数据（不提交到版本控制）
# ==========================================
# ChromaDB（旧，已迁移到 Qdrant）
chroma_db/
chromadb_db/

# Qdrant 本地数据目录（docker volume 或 ./qdrant_storage）
qdrant_storage/
.qdrant/

# ==========================================
# IDE / 编辑器配置文件 (非常重要)
# ==========================================
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace

# ==========================================
# 敏感信息与本地环境配置
# ==========================================
.env
.env.local
.env.*.local
*.jks
*.p12
*.key
*.pem

# ==========================================
# Python 项目通用忽略（推荐添加）
# ==========================================
# 虚拟环境
venv/
env/
.venv/
ENV/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 包管理
*.egg-info/
dist/
build/
*.whl
*.tar.gz

# 测试和覆盖率
