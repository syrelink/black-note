# ==========================================
# 操作系统与系统垃圾 (Global OS files)
# ==========================================
.DS_Store
Thumbs.db
*.swp
desktop.ini

# ==========================================
# 前端项目 (black-note-app)
# ==========================================
black-note-app/node_modules/
black-note-app/dist/
black-note-app/build/
black-note-app/.eslintcache
black-note-app/.stylelintcache
